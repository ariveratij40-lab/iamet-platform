# ═══════════════════════════════════════════════════════════════════════════════
# IAMET Platform — Variables de Entorno (Staging)
# Dominio: staging.iamet.mx
# NUNCA commitear este archivo con valores reales (.env.staging está en .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── URL del Sitio ────────────────────────────────────────────────────────────
# Usada para construir links en correos de verificación de la tienda
VITE_APP_URL=https://staging.iamet.mx

# ─── Base de Datos PostgreSQL ─────────────────────────────────────────────────
# Alimentan docker-compose.staging.yml → servicio postgres
POSTGRES_DB=iamet_staging
POSTGRES_USER=iamet
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_MIN_32_CHARS

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_MIN_32_CHARS

# ─── Seguridad — JWT ──────────────────────────────────────────────────────────
# Firma el JWT de sesión local (cookie manus_session). Portable entre entornos.
# Generar con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_64_CHARS

# ─── Correo (Resend) ──────────────────────────────────────────────────────────
# Dominio iamet.mx verificado en Resend. Sender: noreply@iamet.mx
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── LLM — Agente Virtual IA ──────────────────────────────────────────────────
# Separado de Forge para funcionar en VPS standalone.
# Compatible con cualquier API OpenAI-like: Groq, OpenAI, Mistral, Together AI.
#
# OPCIÓN A — Groq (recomendado para staging, gratis):
#   LLM_API_URL=https://api.groq.com/openai
#   LLM_API_KEY=gsk_XXXXXXXXXXXXXXXX   ← obtener en console.groq.com
#   LLM_MODEL=llama-3.3-70b-versatile
#
# OPCIÓN B — OpenAI (recomendado para producción):
#   LLM_API_URL=https://api.openai.com
#   LLM_API_KEY=sk-proj-XXXXXXXXXXXXXXXX
#   LLM_MODEL=gpt-4o-mini
#
LLM_API_URL=https://api.groq.com/openai
LLM_API_KEY=CAMBIAR_POR_TU_GROQ_API_KEY
LLM_MODEL=llama-3.3-70b-versatile

# ─── Storage — Cloudflare R2 (S3-compatible) ──────────────────────────────────
# Reemplaza Manus Forge Storage. Compatible con AWS S3, Backblaze B2, MinIO.
#
# Pasos para obtener los valores en Cloudflare R2:
#   1. dash.cloudflare.com → R2 Object Storage → Create bucket
#   2. Settings del bucket → Public access → Enable (para imágenes públicas)
#   3. R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
#   4. Copiar Account ID desde la URL del dashboard de R2
#
R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=iamet-staging
R2_ACCESS_KEY_ID=CAMBIAR_POR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CAMBIAR_POR_SECRET_ACCESS_KEY
# URL pública del bucket (si habilitaste acceso público):
#   https://pub-XXXX.r2.dev  (URL automática de R2)
#   https://files.iamet.mx   (dominio custom configurado en R2)
# Dejar vacío si el bucket es privado (usará presigned URLs automáticamente)
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev

# ─── Manus OAuth — REQUIERE REEMPLAZO PARA VPS STANDALONE ────────────────────
# El login de admin NO funcionará en VPS sin reemplazar el sistema OAuth.
# Valores reales del proyecto Manus (funcionan temporalmente si Manus no revoca):
VITE_APP_ID=SsX5E88NhsihTLcjsU3dHR
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# ─── Owner (admin automático) ─────────────────────────────────────────────────
# El usuario con este openId recibe role='admin' automáticamente en db.ts
OWNER_OPEN_ID=Q2TwjGG2RwvDy9n7V3j8cj
# OWNER_NAME no se usa en ningún archivo de código — incluir por compatibilidad
OWNER_NAME=Back IA

# ─── Manus Forge (legacy — dejar vacío en VPS standalone) ────────────────────
# Solo se necesita si usas servicios internos de Manus:
#   notification.ts, imageGeneration.ts, map.ts, voiceTranscription.ts
# En VPS standalone dejar vacío — el servidor arranca sin ellos.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── Frontend (Vite build-time) ───────────────────────────────────────────────
# VITE_FRONTEND_FORGE_API_KEY y VITE_FRONTEND_FORGE_API_URL solo se usan en
# client/src/components/Map.tsx (proxy Google Maps de Manus).
# Map.tsx NO está registrado en App.tsx — no hay rutas activas que lo usen.
# Dejar vacío a menos que implementes mapas con Google Maps Platform directamente.
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
