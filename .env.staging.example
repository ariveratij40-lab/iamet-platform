# ─── IAMET Platform — Variables de Entorno (Staging) ─────────────────────────
# Copiar como .env.staging y completar los valores reales
# NUNCA commitear este archivo con valores reales

# ─── Base de Datos PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=iamet_staging
POSTGRES_USER=iamet
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# ─── Seguridad ────────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_64_CHARS

# ─── URL del Sitio ────────────────────────────────────────────────────────────
# Usada para construir links en correos de verificación
VITE_APP_URL=https://staging.iamet.mx

# ─── Correo (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Manus OAuth (requerido para login de administradores) ───────────────────
# Obtener desde el panel de Manus → Settings → Secrets
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=
OWNER_NAME=

# ─── Manus AI (requerido para el agente virtual y generación de imágenes) ────
# Obtener desde el panel de Manus → Settings → Secrets
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
