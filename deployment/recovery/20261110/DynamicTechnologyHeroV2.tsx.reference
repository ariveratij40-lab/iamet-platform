import { motion, useReducedMotion } from "framer-motion";
import { ArrowRight, Network } from "lucide-react";
import { Link } from "wouter";
import { useLanguage } from "@/contexts/LanguageContext";

const networkPaths = [
  "M-15 65 C8 65 10 20 35 20 S65 75 90 45 S115 15 135 35",
  "M-10 15 C20 -5 30 80 55 60 S95 10 115 55 S135 80 155 50",
  "M-15 95 C20 65 35 110 60 45 S100 85 125 20 S145 10 165 5",
  "M10 -10 C30 20 15 55 45 80 S90 45 110 105",
  "M55 -15 C75 25 50 55 85 70 S120 35 145 95",
] as const;

export default function DynamicTechnologyHeroV2() {
  const { language } = useLanguage();
  const reduceMotion = useReducedMotion();
  const es = language === "es";

  return (
    <section
      aria-labelledby="iamet-v9-hero-title"
      className="relative isolate flex min-h-[640px] items-center overflow-hidden bg-[#07111F] px-6 py-24 text-white sm:min-h-[720px] lg:min-h-[78vh]"
    >
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-0"
      >
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_75%_40%,rgba(37,99,235,.23),transparent_55%)]" />
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_25%_80%,rgba(34,211,238,.10),transparent_50%)]" />

        <svg
          viewBox="0 0 140 100"
          preserveAspectRatio="xMidYMid slice"
          className="absolute inset-0 h-full w-full"
        >
          <defs>
            <linearGradient
              id="iamet-v91-flow"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="100%"
            >
              <stop offset="0%" stopColor="#2166FF" />
              <stop offset="55%" stopColor="#4B8DFF" />
              <stop offset="100%" stopColor="#22D3EE" />
            </linearGradient>

            <filter
              id="iamet-v91-glow"
              x="-100%"
              y="-100%"
              width="300%"
              height="300%"
            >
              <feGaussianBlur stdDeviation=".65" />
            </filter>
          </defs>

          {networkPaths.map((path, index) => (
            <g key={index}>
              <path
                d={path}
                fill="none"
                stroke="#2166FF"
                strokeWidth=".7"
                opacity=".16"
                filter="url(#iamet-v91-glow)"
              />

              <path
                d={path}
                fill="none"
                stroke="url(#iamet-v91-flow)"
                strokeWidth=".16"
                opacity=".58"
              />

              <motion.path
                d={path}
                fill="none"
                stroke="#A5F3FC"
                strokeWidth=".35"
                strokeLinecap="round"
                strokeDasharray="1 25"
                initial={{ strokeDashoffset: 0 }}
                animate={
                  reduceMotion
                    ? { strokeDashoffset: 0 }
                    : { strokeDashoffset: -104 }
                }
                transition={{
                  duration: 8 + index * 2,
                  repeat: reduceMotion ? 0 : Infinity,
                  ease: "linear",
                }}
              />
            </g>
          ))}
        </svg>

        <motion.div
          className="absolute -right-[15%] top-[5%] h-[70%] w-[70%] rounded-full bg-blue-600/10 blur-[100px]"
          animate={
            reduceMotion
              ? undefined
              : {
                  x: [-30, 30, -30],
                  y: [20, -20, 20],
                  opacity: [0.35, 0.65, 0.35],
                }
          }
          transition={{
            duration: 22,
            repeat: Infinity,
            ease: "easeInOut",
          }}
        />

        <motion.div
          className="absolute right-[5%] top-[20%] h-[45%] w-[45%] rounded-full bg-cyan-400/10 blur-[90px]"
          animate={
            reduceMotion
              ? undefined
              : {
                  x: [20, -25, 20],
                  y: [-15, 25, -15],
                }
          }
          transition={{
            duration: 18,
            repeat: Infinity,
            ease: "easeInOut",
          }}
        />

        <div className="absolute inset-0 bg-gradient-to-r from-[#07111F] via-[#07111F]/85 to-transparent" />
      </div>

      <div className="relative z-10 mx-auto w-full max-w-[1344px]">
        <div className="max-w-[760px]">
          <div className="mb-7 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/5 px-4 py-2 text-xs font-semibold tracking-[.16em] text-cyan-200">
            <Network size={16} aria-hidden="true" />
            IAMET · {es ? "INTEGRACIÓN TECNOLÓGICA" : "TECHNOLOGY INTEGRATION"}
          </div>

          <motion.h1
            id="iamet-v9-hero-title"
            initial={reduceMotion ? false : { opacity: 0, y: 18 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.8 }}
            className="max-w-[800px] text-4xl font-bold leading-[1.08] tracking-tight sm:text-5xl lg:text-7xl"
          >
            {es
              ? "Integramos tecnología que impulsa su operación."
              : "We integrate technology that powers your operations."}
          </motion.h1>

          <p className="mt-7 max-w-[620px] text-base leading-8 text-slate-300 sm:text-lg">
            {es
              ? "Infraestructura de red, seguridad electrónica, energía y soluciones inteligentes para operaciones empresariales."
              : "Network infrastructure, electronic security, power and intelligent solutions for enterprise operations."}
          </p>

          <div className="mt-10 flex flex-wrap gap-4">
            <Link
              href="/cotizacion"
              className="inline-flex min-h-12 items-center gap-3 rounded-lg bg-[#2166FF] px-6 py-3 font-semibold text-white transition hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
            >
              {es ? "Solicitar asesoría" : "Request consultation"}
              <ArrowRight size={18} aria-hidden="true" />
            </Link>

            <Link
              href="/soluciones"
              className="inline-flex min-h-12 items-center rounded-lg border border-white/25 bg-white/5 px-6 py-3 font-semibold text-white backdrop-blur-sm transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
            >
              {es ? "Explorar soluciones" : "Explore solutions"}
            </Link>
          </div>
        </div>
      </div>
    </section>
  );
}
