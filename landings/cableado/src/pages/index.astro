---
import '../styles/main.css';
const enabled = import.meta.env.PUBLIC_CAPTURE_ENABLED === 'true' && !!import.meta.env.PUBLIC_PRIVACY_URL;
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || '/api/leads';
const privacy = import.meta.env.PUBLIC_PRIVACY_URL;
const whatsapp = 'https://wa.me/526643314515?text=' + encodeURIComponent('Hola, me interesa cotizar cableado estructurado y fibra óptica para mi empresa en Tijuana.');
---
<!doctype html>
<html lang="es-MX"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="index,follow"/><title>Cableado estructurado Panduit y fibra óptica en Tijuana | IAMET</title><meta name="description" content="Cableado estructurado Panduit y fibra óptica para empresas industriales en Tijuana. Consulta acreditación, alcance técnico y cotización con IAMET."/><link rel="canonical" href="https://cableadoestructurado.iamet.mx/"/></head>
<body>
<a class="skip" href="#contenido">Ir al contenido</a>
{!enabled && <div class="preview">Vista previa local · El formulario todavía no envía solicitudes al CRM.</div>}
<header class="landing-header"><div class="wrap header-inner"><a href="#" aria-label="IAMET, inicio"><img class="logo" src="/brand/iamet-principal.svg" alt="IAMET · Integración tecnológica" width="245" height="67"/></a><div class="header-contact"><a class="header-phone" href="tel:+526643701639" aria-label="Llamar a IAMET al 664 370 1639"><span>LLÁMANOS</span>664 370 1639</a></div></div></header>
<main id="contenido">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy">
  <h1>Empresa integradora certificada en cableado estructurado y fibra óptica Panduit.</h1>
  <a class="button mobile-cta" href="#cotizar">Solicitar cotización ↗</a>
<ul class="hex-gallery" aria-label="Soluciones Panduit">
    <li><div class="hex-shadow"><div class="hex-frame"><img src="/images/banner/angled-panel.jpg" alt=""/></div></div><span>Panel de parcheo</span></li>
    <li><div class="hex-shadow"><div class="hex-frame"><img src="/images/banner/patch-cord-28awg.jpg" alt=""/></div></div><span>Cordón de parcheo</span></li>
    <li><div class="hex-shadow"><div class="hex-frame"><img class="product-photo" src="/images/banner/fiber-adapter-panel-panduit.jpg" alt=""/></div></div><span>Adaptadores de fibra</span></li>
    <li><div class="hex-shadow"><div class="hex-frame"><img src="/images/banner/fmt1-fiber-tray.jpg" alt=""/></div></div><span>Bandeja de fibra</span></li>
    <li><div class="hex-shadow"><div class="hex-frame"><img src="/images/banner/nmf4-manager.jpg" alt=""/></div></div><span>Organizador de cables</span></li>
