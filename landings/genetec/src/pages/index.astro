import '../styles/main.css';
import AccessIcon from '../components/AccessIcon.astro';
const privacy = import.meta.env.PUBLIC_PRIVACY_URL || 'https://privacidad.iamet.mx/';
const enabled = import.meta.env.PUBLIC_CAPTURE_ENABLED === 'true';
const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || '/api/leads';
const indexable = enabled && import.meta.env.PUBLIC_INDEXABLE === 'true';
const official = 'https://www.genetec.com/products/unified-security/security-center';
const whatsapp = 'https://wa.me/526643701639?text=' + encodeURIComponent('Hola, me interesa un proyecto integral de seguridad con Genetec.');
const solutions = [
 {id:'video',icon:'camera',verb:'Ver lo que ocurre',name:'Omnicast',category:'VIDEOVIGILANCIA',image:'video.png',alt:'Operador frente a pantallas de videovigilancia',text:'Consulta video en vivo y grabaciones para supervisar instalaciones e investigar eventos.',example:'Ejemplo: revisar qué ocurrió en un acceso.',device:'Cámaras IP y almacenamiento',url:'https://www.genetec.com/products/unified-security/omnicast'},
 {id:'accesos',icon:'door',verb:'Controlar quién entra',name:'Synergis',category:'CONTROL DE ACCESO',image:'access-control.jpg',alt:'Personas pasando por accesos controlados en un edificio',text:'Administra credenciales, puertas, áreas y horarios de acceso.',example:'Ejemplo: dar acceso a oficinas según el turno.',device:'Lectores, controladores y cerraduras',url:'https://www.genetec.com/products/unified-security/synergis'},
 {id:'vehiculos',icon:'car',verb:'Identificar vehículos',name:'AutoVu',category:'RECONOCIMIENTO DE PLACAS',image:'vehiculos.jpg',alt:'Vista aérea de vehículos circulando en una vialidad',text:'Reconoce placas y consulta registros vehiculares con soluciones fijas o móviles.',example:'Ejemplo: investigar el paso de un vehículo.',device:'Equipos de reconocimiento de placas',url:'https://www.genetec.com/products/unified-security/autovu'},
 {id:'comunicacion',icon:'phone',verb:'Hablar y coordinar',name:'Sipelia',category:'COMUNICACIONES',image:'comunicacion.jpg',alt:'Operadora utilizando audífonos para gestionar comunicaciones',text:'Integra intercomunicadores y comunicaciones SIP con la operación de seguridad.',example:'Ejemplo: atender una llamada desde la entrada.',device:'Intercomunicadores y dispositivos SIP',url:'https://www.genetec.com/products/unified-security/sipelia'},
 ];
const catalog = [...solutions,
 {id:'mission-control',name:'Mission Control',category:'Gestión de incidentes',text:'Reúne los eventos de un incidente y guía al operador con procedimientos definidos por la organización. Ante una alarma, el equipo puede verificar lo ocurrido y documentar su respuesta.',image:'centro-monitoreo.jpg',alt:'Operador consultando un plano y un panel de incidentes'},
 {id:'intrusion',name:'Intrusion Panel',category:'Integración de paneles de intrusión',text:'Conecta paneles de alarma compatibles con Security Center para identificar la zona que generó una alerta y consultar el video asociado antes de enviar personal.',image:'intrusion.jpg',alt:'Panel rojo de alarma con canalización metálica junto a gabinetes de servidores'},
 {id:'industrial-iot',name:'Industrial IoT',category:'Monitoreo de sensores industriales',text:'Integra lecturas de sensores y equipos compatibles en Security Center. Por ejemplo, una medición de temperatura fuera del rango configurado puede alertar al operador para que revise el equipo.',image:'industrial-iot.jpg',alt:'Transmisor de temperatura instalado en una tubería industrial'}
];
---
<!doctype html><html lang="es-MX"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Genetec: soluciones integrales de seguridad | IAMET Tijuana</title>
<meta name="description" content="Conecta videovigilancia, control de acceso, reconocimiento de placas y comunicaciones con Genetec e IAMET. Explora soluciones, topología y proyectos en Tijuana."/>
<meta name="robots" content={indexable?'index,follow':'noindex,nofollow'}/><link rel="canonical" href="https://genetec.iamet.mx/"/>
<meta property="og:type" content="website"/><meta property="og:title" content="Genetec + IAMET · Tu seguridad, conectada"/><meta property="og:description" content="Video, accesos, vehículos y comunicaciones. Una visión integral de tu instalación."/><meta property="og:url" content="https://genetec.iamet.mx/"/><meta property="og:image" content="https://genetec.iamet.mx/images/video.png"/>
</head><body><a class="skip" href="#contenido">Ir al contenido</a>
{!enabled && <div class="preview">Vista previa · El formulario aún no envía solicitudes.</div>}
<header class="wrap campaign-header"><img class="logo" src="/brand/iamet-principal.svg" alt="IAMET · Integración tecnológica" width="245" height="67"/><a class="campaign-call" href="tel:+526643808965"><span>Llamar a IAMET</span><strong>+52 664 380 8965</strong></a></header>
<main id="contenido">
<section class="monitor-banner"><div class="monitor-scene"><img src="/images/centro-monitoreo.jpg" alt="Escena ilustrativa de un operador con radio frente a un videowall con planos de Security Center y el panel de Mission Control"/><h1>Genetec Security Center</h1></div><div class="monitor-foot"><strong>{import.meta.env.DEV ? "Integrador Certificado Genetec" : "Integración Genetec"}</strong><span>CCTV - Control de Acceso - LPR - IoT</span><a class="quote-link" href="#cotizar">Solicitar cotización</a></div></section>
<section class="wrap catalog" id="soluciones" aria-labelledby="catalog-title">
<h2 id="catalog-title">Soluciones que Genetec ofrece</h2>
{catalog.map(item => <article class="catalog-row" id={item.id}>
  <div><p class="eyebrow">{item.category}</p><h3>{item.name}</h3><p>{item.text}</p><a class="interest-link" href="#cotizar" data-solution={item.name} aria-label={`Me interesa ${item.name}`}>Me interesa</a></div>
  <img src={'/images/'+item.image} alt={item.alt} loading="lazy" width="720" height="340"/>
</article>)}
</section>
<section id="topologia" class="modular"><div class="wrap"><h2>Cómo funciona Genetec</h2><p>Puede comenzar con videovigilancia y sumar control de acceso, lectura de placas u otras funciones conforme cambien las necesidades de su instalación.</p><figure><div class="mod-root"><strong>Genetec Security Center</strong><span>Plataforma común para consultar eventos y operar las soluciones integradas</span></div><div class="mod-branches"><div class="mod-branch"><h3>Video y accesos</h3><a href="#video"><strong>Omnicast</strong><span>Cámaras IP → video en vivo y grabaciones</span></a><a href="#accesos"><strong>Synergis</strong><span>Lectores y controladores → eventos de puerta</span></a><a href="#vehiculos"><strong>AutoVu</strong><span>Cámaras lectoras de placas → registros de vehículos</span></a></div><div class="mod-branch"><h3>Comunicación y señales</h3><a href="#comunicacion"><strong>Sipelia</strong><span>Intercomunicadores SIP → llamadas al operador</span></a><a href="#intrusion"><strong>Intrusion Panel</strong><span>Paneles compatibles → alarmas por zona</span></a><a href="#industrial-iot"><strong>Industrial IoT</strong><span>Sensores compatibles → mediciones y alertas</span></a></div><div class="mod-branch"><h3>Gestión de incidentes</h3><a href="#mission-control"><strong>Mission Control</strong><span>Eventos de los sistemas integrados → procedimientos guiados para el operador</span></a></div></div><figcaption>Ejemplo en una planta: Synergis detecta una puerta forzada, Omnicast aporta el video asociado y Mission Control guía al operador para verificar el incidente y registrar su respuesta. Este flujo requiere configurar las asociaciones y el procedimiento.</figcaption></figure><p class="mod-note">Topología funcional de referencia. La selección de módulos, licencias y equipos depende de la compatibilidad y del alcance del proyecto.</p><figure class="org" aria-labelledby="org-title"><h3 id="org-title">Security Center y sus módulos</h3><div class="org-tree"><div class="org-group"><div class="org-list"><a href="#video">Omnicast</a><a href="#accesos">Synergis</a><a href="#vehiculos">AutoVu</a></div><strong>Video y accesos</strong></div><div class="org-group"><div class="org-list"><a href="#comunicacion">Sipelia</a><a href="#intrusion">Intrusion Panel</a><a href="#industrial-iot">Industrial IoT</a></div><strong>Comunicación y sensores</strong></div><div class="org-group"><div class="org-list"><a href="#mission-control">Mission Control</a></div><strong>Gestión de incidentes</strong></div></div><div class="org-base"><strong>Genetec Security Center</strong><span>Plataforma base</span></div><figcaption>Cada rama agrupa funciones que puede incorporar según su proyecto. Seleccione un módulo para consultar su descripción.</figcaption></figure></div></section><section class="designer wrap" id="disenar"><h2>Cómo diseñar mi solución Genetec</h2><p>Arme un primer alcance para su instalación y llévelo al formulario de cotización.</p><fieldset><legend>1. Elija la plataforma</legend><label>Modalidad <select id="design-mode"><option value="local">Security Center · instalación local</option><option value="saas">Security Center SaaS · nube o híbrido</option></select></label><p id="design-mode-note">En sitio, la propuesta parte de Security Center e incorpora las conexiones y módulos necesarios. La edición y la infraestructura se dimensionan para su proyecto.</p></fieldset><fieldset><legend>2. Defina el horizonte del proyecto</legend><label><span id="term-label">Cobertura de soporte deseada</span> <select id="design-term"><option value="">Por definir</option><option>1 año</option><option>2 años</option><option>3 años</option><option>5 años</option></select></label><p id="term-note">Indique el plazo que desea cotizar para Genetec Advantage. La licencia de la plataforma y la cobertura de soporte se especifican por separado. IAMET confirmará los plazos disponibles para las referencias seleccionadas.</p></fieldset><fieldset><legend>3. Añada las soluciones que necesita</legend><p>Introduzca cantidades aproximadas. Deje en blanco lo que todavía no requiere. Estas cantidades describen su instalación; las licencias se determinan al revisar el alcance.</p><div class="design-grid"><label><strong>Omnicast</strong><span>Canales de video</span><input type="number" min="0" step="1" placeholder="0" data-design="Omnicast" data-unit="Canales de video"/><small>Cuente los canales que desea grabar. Confirme el modelo de cámara si utiliza equipos multisensor.</small></label><label><strong>Synergis</strong><span>Lectores de acceso</span><input type="number" min="0" step="1" placeholder="0" data-design="Synergis" data-unit="Lectores de acceso"/><small>Una puerta con lector de entrada y otro de salida suma dos lectores.</small></label><label><strong>AutoVu</strong><span>Puntos de lectura de placas</span><input type="number" min="0" step="1" placeholder="0" data-design="AutoVu" data-unit="Puntos de lectura de placas"/><small>Indique cuántos accesos o carriles requieren reconocimiento de placas.</small></label><label><strong>Sipelia</strong><span>Intercomunicadores</span><input type="number" min="0" step="1" placeholder="0" data-design="Sipelia" data-unit="Intercomunicadores"/><small>Cuente los puntos desde los que se iniciarán o recibirán llamadas.</small></label><label><strong>Mission Control</strong><span>Procedimientos de respuesta</span><input type="number" min="0" step="1" placeholder="0" data-design="Mission Control" data-unit="Procedimientos de respuesta"/><small>Identifique los incidentes que requieren guiar al operador paso a paso.</small></label><label><strong>Intrusion Panel</strong><span>Paneles de intrusión</span><input type="number" min="0" step="1" placeholder="0" data-design="Intrusion Panel" data-unit="Paneles de intrusión"/><small>Indique cuántos paneles existentes desea integrar y, si los conoce, sus modelos.</small></label><label><strong>Industrial IoT</strong><span>Dispositivos industriales</span><input type="number" min="0" step="1" placeholder="0" data-design="Industrial IoT" data-unit="Dispositivos industriales"/><small>Cuente los equipos o sensores y detalle qué variables desea supervisar.</small></label></div></fieldset><p><strong>Ejemplo local.</strong> Para 16 cámaras de un canal y cuatro puertas con lector de entrada y salida, solicite Security Center con 16 conexiones de video Omnicast y ocho conexiones de lector Synergis. Puede incorporar lectura de placas en una etapa posterior.</p><h3>Su configuración</h3><p id="design-summary" aria-live="polite"></p><button type="button" class="design-cta">Llevar al formulario</button></section><section class="wrap gen-faq" id="preguntas" aria-labelledby="faq-title"><h2 id="faq-title">Preguntas frecuentes sobre Genetec</h2><details><summary>¿Puedo empezar con cámaras y añadir control de acceso después?</summary><p>Sí. Puede plantear una primera etapa de video con Omnicast y una segunda de control de acceso con Synergis. Conviene indicar desde el inicio cuántas puertas y sedes prevé incorporar para dimensionar la plataforma.</p></details><details><summary>¿Puedo aprovechar las cámaras, lectores y controladores que ya tengo?</summary><p>Depende del modelo, la versión de firmware y las funciones que necesite. Comparta su inventario e indique qué quiere conservar de cada equipo, por ejemplo grabación, audio o eventos de puerta.</p></details><details><summary>¿Qué cambia entre Security Center local y Security Center SaaS?</summary><p>En un despliegue local se dimensionan los servidores y el almacenamiento de su instalación. SaaS se contrata por suscripción y puede combinar equipos en sitio con servicios en la nube. Para comparar las opciones, conviene revisar la conectividad de cada sede y cuántos días de video necesita conservar.</p></details><details><summary>¿Qué cantidades necesito para cotizar video y accesos?</summary><p>Para video, indique el número de cámaras y canales. Para accesos, cuente los lectores por separado: una puerta con lector de entrada y lector de salida suma dos lectores. Si desconoce algún dato, puede solicitar la cotización con una estimación.</p></details><details><summary>¿Cómo calculo cuánto tiempo puedo guardar las grabaciones?</summary><p>Empiece por definir los días que necesita consultar y qué cámaras graban continuamente o por evento. Con esos datos, la resolución y la tasa de bits se estima la capacidad de almacenamiento requerida.</p></details><details><summary>¿Qué soporte incluye la propuesta?</summary><p>Solicite que se detallen la vigencia y el alcance de Genetec Advantage, así como los servicios que prestaría IAMET. Si requiere atención en sitio, indique las sedes y los horarios que necesita cubrir.</p></details><details><summary>¿Qué información envío para recibir una cotización?</summary><p>Indique la ciudad, el número de sedes, los equipos que ya tiene y el problema que desea resolver. Puede usar el configurador y pulsar «Llevar al formulario» para incorporar las cantidades a su solicitud.</p></details></section><section id="videowall" class="wrap wall"><h2>Selecciona tu videowall</h2><p>El primer número indica columnas y el segundo, filas. Los esquemas muestran el muro de pantallas frente a la consola del operador.</p><p class="wall-advice" aria-live="polite">Seleccione sus soluciones en el configurador para ver una sugerencia.</p><div class="wall-options"><article><div class="wall-room" role="img" aria-label="Centro de monitoreo con 2 columnas y 1 filas de pantallas"><div class="wall-screens" style="grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(1,1fr)"><i></i><i></i></div><div class="wall-console"></div></div><h3>2×1 · 2 pantallas</h3><p>Una vista de trabajo y otra de contexto.</p><button type="button" data-wall="2×1">Seleccionar 2×1</button></article><article><div class="wall-room" role="img" aria-label="Centro de monitoreo con 2 columnas y 2 filas de pantallas"><div class="wall-screens" style="grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(2,1fr)"><i></i><i></i><i></i><i></i></div><div class="wall-console"></div></div><h3>2×2 · 4 pantallas</h3><p>Cuatro pantallas para separar video, accesos, mapa y alarmas.</p><button type="button" data-wall="2×2">Seleccionar 2×2</button></article><article><div class="wall-room" role="img" aria-label="Centro de monitoreo con 3 columnas y 2 filas de pantallas"><div class="wall-screens" style="grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr)"><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="wall-console"></div></div><h3>3×2 · 6 pantallas</h3><p>Seis pantallas para supervisar varias funciones en paralelo.</p><button type="button" data-wall="3×2">Seleccionar 3×2</button></article><article><div class="wall-room" role="img" aria-label="Centro de monitoreo con 3 columnas y 3 filas de pantallas"><div class="wall-screens" style="grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr)"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><div class="wall-console"></div></div><h3>3×3 · 9 pantallas</h3><p>Nueve pantallas para una operación con varias vistas simultáneas.</p><button type="button" data-wall="3×3">Seleccionar 3×3</button></article></div><p>La sugerencia considera los módulos indicados. Para dimensionar el videowall se revisan las vistas simultáneas, la distancia de lectura, los operadores por turno y el espacio disponible.</p></section><section class="topology-section"><div class="wrap"><div class="deployment-options"><article><p class="eyebrow">INFRAESTRUCTURA LOCAL</p><h3>Security Center</h3><p>Operación sobre una infraestructura definida para tu organización, con servidores y almacenamiento dimensionados al proyecto.</p></article><article><p class="eyebrow">NUBE E INFRAESTRUCTURA HÍBRIDA</p><h3>Security Center SaaS</h3><p>Una alternativa de servicio que combina recursos de nube, equipos locales y dispositivos de borde. Revisamos capacidades y requisitos específicos.</p><a href="https://www.genetec.com/products/unified-security/security-center-saas/" target="_blank" rel="noopener noreferrer">Conocer la opción SaaS ↗</a></article></div></div></section>
<section class="wrap practical"><div class="section-heading"><p class="eyebrow">UN EJEMPLO PRÁCTICO</p><h2>Una visita llega.<br/>Tu equipo tiene contexto.</h2><p>Escenario ilustrativo de una instalación con sistemas integrados. El flujo y las autorizaciones se configuran para cada proyecto.</p></div><div class="scenario-flow"><article><span>01</span><AccessIcon name="car"/><h3>Identifica</h3><p>AutoVu registra la placa al llegar a la instalación.</p></article><article><span>02</span><AccessIcon name="phone"/><h3>Comunica</h3><p>El visitante llama por el intercomunicador y el operador atiende con Sipelia.</p></article><article><span>03</span><AccessIcon name="camera"/><h3>Verifica</h3><p>El equipo consulta el video de la entrada mediante Omnicast.</p></article><article><span>04</span><AccessIcon name="door"/><h3>Controla</h3><p>Synergis gestiona el acceso conforme a los permisos y al procedimiento establecido.</p></article></div><p class="graphic-note">Reconocer una placa no implica autorizar automáticamente la apertura de una barrera.</p></section>
<section class="extend"><div class="wrap"><div class="section-heading"><p class="eyebrow">AMPLÍA SEGÚN TU OPERACIÓN</p><h2>Más capacidades,<br/>cuando las necesitas.</h2><p>Estas soluciones complementan el proyecto. Sus licencias, integraciones y disponibilidad se evalúan por separado.</p></div><div class="extensions"><article><AccessIcon name="shield"/><h3>Alarmas de intrusión</h3><p>Integra paneles compatibles para relacionar alarmas con el resto de la operación.</p><a href="https://www.genetec.com/resources/feature-notes/intrusion-panel-integration" target="_blank" rel="noopener noreferrer">Ver integración ↗</a></article><article><AccessIcon name="screen"/><h3>Mission Control</h3><p>Gestión de incidentes y procedimientos para orientar la respuesta del operador.</p><a href="https://www.genetec.com/products/operations/mission-control" target="_blank" rel="noopener noreferrer">Conocer solución ↗</a></article><article><AccessIcon name="person"/><h3>ClearID</h3><p>Gestión de identidades y solicitudes de acceso físico vinculadas con Synergis.</p><a href="https://techdocs.genetec.com/r/en-US/Genetec-ClearIDTM-User-Guide/How-the-ClearID-plugin-works-with-Security-Center" target="_blank" rel="noopener noreferrer">Conocer integración ↗</a></article><article><AccessIcon name="card"/><h3>Clearance</h3><p>Reúne, administra y comparte evidencia digital para apoyar investigaciones.</p><a href="https://techdocs.genetec.com/r/en-US/Security-Center-SaaS-Setup-Guide/About-Clearance-in-Security-Center-SaaS" target="_blank" rel="noopener noreferrer">Conocer solución ↗</a></article></div></div></section>
<section class="wrap project-contact"><div><p class="eyebrow">TU PROYECTO CON IAMET</p><h2>Cuéntanos qué proteges.<br/>Definamos cómo conectarlo.</h2><p>Una planta, un corporativo o varias ubicaciones. Empezamos por entender tu operación y los sistemas que ya tienes.</p><ol class="contact-steps"><li><span>01</span><div><strong>Revisamos tu necesidad</strong><p>Instalación, equipos existentes y prioridades.</p></div></li><li><span>02</span><div><strong>Definimos la arquitectura</strong><p>Compatibilidad, infraestructura e integraciones.</p></div></li><li><span>03</span><div><strong>Acordamos el alcance</strong><p>Equipos, licencias, implementación y pruebas.</p></div></li></ol><a href="tel:+526643701639" class="contact-phone">664 370 1639 ↗</a></div>
</section>

<div class="quote" id="cotizar"><p class="eyebrow">HABLEMOS DE TU PROYECTO</p><h2>Solicita una cotización</h2><p>Un sistema nuevo o la integración del actual.<br/>Cuéntanos qué necesita tu empresa.</p>
      <form id="lead-form" data-enabled={String(enabled)} data-endpoint={endpoint}>
        <div class="two"><label>Nombre <span aria-hidden="true">*</span><input name="contactName" autocomplete="name" required minlength="2" maxlength="128"/></label><label>Empresa <span aria-hidden="true">*</span><input name="company" autocomplete="organization" required minlength="2" maxlength="256"/></label></div>
        <label>Correo electrónico <span aria-hidden="true">*</span><input type="email" name="email" autocomplete="email" required maxlength="320"/></label>
        <label>Teléfono <small>opcional</small><input type="tel" name="phone" autocomplete="tel" maxlength="32"/></label>
        <label>¿Qué necesita proteger o qué solución desea? <span aria-hidden="true">*</span><textarea name="problemDescription" required minlength="10" maxlength="3000" rows="3" placeholder="Ciudad, tipo de instalación y necesidades de video, accesos, vehículos o comunicaciones."></textarea></label>
        <div class="trap" aria-hidden="true"><label>Sitio web<input name="website" tabindex="-1" autocomplete="off"/></label></div>
        <p class="privacy">Usaremos tus datos para atender esta solicitud. Consulta el <a href={privacy}>aviso de privacidad</a>.</p>
        <button class="button" type="submit" disabled={!enabled}>{enabled ? 'Solicitar cotización ↗' : 'Envío pendiente de conexión'}</button>
        <p id="form-status" role="status" aria-live="polite"></p><noscript><p>Activa JavaScript para enviar el formulario o utiliza WhatsApp.</p></noscript>
      </form></div></main><footer class="wrap"><div class="foot-brand"><img src="/brand/iamet-principal.svg" alt="IAMET · Integración tecnológica" width="205" height="56"/><a class="foot-request" href="#cotizar">Solicitar cotización</a></div><div><a href="https://iamet.mx/">Sitio corporativo ↗</a><a href="/articulos/costo-videovigilancia-empresas/">Guía de costos de videovigilancia</a><a href={privacy}>Aviso de privacidad</a><a href={official} target="_blank" rel="noopener noreferrer">Fuentes: Genetec ↗</a></div><p>© {new Date().getFullYear()} IAMET</p><p class="trademark">Las marcas y fotografías de producto pertenecen a sus respectivos titulares. Esta página presenta la atención de proyectos por IAMET. Las topologías y los escenarios son ilustrativos.</p></footer><script>import '../scripts/form.js';import '../scripts/configurator.js';</script></body></html>
